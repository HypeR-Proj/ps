{
  "version": 1,
  "name": "ps",
  "kind": "application",
  "origin": {
    "repository": "https://github.com/roolrz/HypeR",
    "commit": "8d42d047058a2b58a291803700e86487fb723f7a"
  },
  "sources": {
    "Cargo.toml": "app/ps/Cargo.toml",
    "component.mk": "app/ps/component.mk",
    "src/cli.rs": "app/ps/src/cli.rs",
    "src/lib.rs": "app/ps/src/lib.rs",
    "src/main.rs": "app/ps/src/main.rs",
    "tests/cli.rs": "app/ps/tests/cli.rs"
  },
  "SPDX-FileCopyrightText": "2026 roolrz",
  "SPDX-License-Identifier": "Apache-2.0",
  "mounts": {
    "": "app/ps"
  },
  "packages": [
    "hyper-ps"
  ],
  "tests": [
    [
      "make",
      "app-test",
      "APP_TEST_PACKAGE=hyper-ps"
    ]
  ],
  "cargo_context": {
    "Cargo.toml": {
      "workspace": null,
      "membership": "..",
      "dependency_paths": {
        "target.cfg(target_os = \"hyper\")/dependencies/hyper-clap-shared": "lib/clap",
        "target.cfg(target_os = \"hyper\")/dependencies/hyper-tool-args-shared": "lib/tool-args/shared",
        "target.cfg(not(target_os = \"hyper\"))/dependencies/hyper-tool-args": "lib/tool-args"
      },
      "inherited_dependencies": {
        "/dependencies/clap": {
          "workspace": true
        },
        "/dependencies/hyper-os": {
          "workspace": true
        },
        "/dependencies/hyper-rt": {
          "workspace": true
        },
        "target.cfg(target_os = \"hyper\")/dependencies/hyper-clap-shared": {
          "workspace": true
        },
        "target.cfg(target_os = \"hyper\")/dependencies/hyper-tool-args-shared": {
          "workspace": true
        },
        "target.cfg(not(target_os = \"hyper\"))/dependencies/hyper-tool-args": {
          "workspace": true
        }
      }
    }
  }
}
